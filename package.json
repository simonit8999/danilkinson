{
  "name": "undefined-arch-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.mjs",
    "start": "npm run build && npm run server",
    "tunnel": "ngrok http 127.0.0.1:3000",
    "publish": "node server/publish.mjs",
    "hash-admin": "node scripts/hash-admin.mjs",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/make-icons.ps1",
    "bg": "powershell -ExecutionPolicy Bypass -File scripts/build-bg.ps1",
    "check": "node scripts/api-check.mjs",
    "check:publish": "node scripts/publish-check.mjs",
    "tap-check": "node scripts/tap-check.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
