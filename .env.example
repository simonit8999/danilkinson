# Локальный сервер каталога (server/index.mjs)
PORT=3000
HOST=127.0.0.1

# Для сборки, которая открывается НЕ с сервера (например GitHub Pages):
# укажите адрес туннеля целиком, без слэша в конце.
# VITE_API_URL=https://cricket-palpable-chatter.ngrok-free.dev

# Адрес API, который сборка использует на GitHub Pages по умолчанию.
# Если не задан — берётся DEFAULT_PUBLIC_API из src/config.ts.
# Меняйте только если у ngrok сменился домен; VITE_API_URL главнее.
# VITE_PUBLIC_API_URL=https://cricket-palpable-chatter.ngrok-free.dev
